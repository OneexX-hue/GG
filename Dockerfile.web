FROM node:24-bookworm-slim AS builder

WORKDIR /app

# npmjs.org is flaky/rate-limited from some datacenters — mirror is a drop-in replacement.
ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

RUN npm install -g pnpm@10

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json tsconfig.json ./
COPY lib/db ./lib/db
COPY lib/api-spec ./lib/api-spec
COPY lib/api-client-react ./lib/api-client-react
COPY artifacts/quest ./artifacts/quest

RUN pnpm install --frozen-lockfile

# Build typecheck libs
RUN pnpm run typecheck:libs || true

# Build frontend
ENV PORT=21234
ENV BASE_PATH=/
RUN cd artifacts/quest && pnpm run build

# ---- Serve stage ----
FROM nginx:alpine

COPY --from=builder /app/artifacts/quest/dist/public /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
